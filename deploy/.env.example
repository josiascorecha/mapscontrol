# Copie para deploy/.env na VPS (NUNCA versione o .env real) e preencha.
# Gere segredos com:  openssl rand -hex 32   (hex evita caracteres especiais na URL do banco)

APP_ORIGIN=https://mapscontrol.exemplo.com.br
APP_PORT=8087
APP_VERSION=latest

POSTGRES_PASSWORD=troque-por-um-segredo-longo
CODE_PEPPER=troque-por-outro-segredo-com-pelo-menos-32-caracteres

# E-mail (SMTP). Ex.: provedor transacional ou SMTP do domínio.
MAIL_TRANSPORT=smtp
MAIL_FROM=MapsControl <nao-responda@exemplo.com.br>
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario
SMTP_PASS=senha

CONTACT_EMAIL=contato@exemplo.com.br
TERMS_VERSION=2026-09-26
PRIVACY_VERSION=2026-09-26
SESSION_TTL_DAYS=30
AUDIT_RETENTION_DAYS=730
LOG_LEVEL=info

# Mapa (OpenStreetMap por padrão; respeite a política de uso dos tiles).
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Android (TWA): preencha depois de gerar a chave de assinatura / Play App Signing.
ANDROID_PACKAGE=
ANDROID_CERT_SHA256=

# Backups
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=3

# Somente para o script bootstrap-global-admin (pode ser passado na linha de comando em vez daqui)
GLOBAL_ADMIN_EMAIL=
GLOBAL_ADMIN_NAME=
