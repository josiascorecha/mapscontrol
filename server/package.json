{
  "name": "mapscontrol-server",
  "version": "0.1.0",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/cli/migrate.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bootstrap:global-admin": "node dist/cli/bootstrap-global-admin.js",
    "seed:demo": "node dist/cli/seed-demo.js",
    "import:territory": "node dist/cli/import-territory.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
